// {{ ansible_managed }}

{
    "Dhcp4": {
        "interfaces-config": {
            "interfaces": [
                "eth0"
            ]
        },

        "control-socket": {
            "socket-type": "unix",
            "socket-name": "kea4-ctrl-socket"
        },

        "lease-database": {
            "type": "memfile",
            "lfc-interval": 3600
        },

        // from the example default/config
        "expired-leases-processing": {
            "reclaim-timer-wait-time": 10,
            "flush-reclaimed-timer-wait-time": 25,
            "hold-reclaimed-time": 3600,
            "max-reclaim-leases": 100,
            "max-reclaim-time": 250,
            "unwarned-reclaim-cycles": 5
        },

        "renew-timer": 900,
        "rebind-timer": 1800,
        "valid-lifetime": 3600,

        "client-classes": [
            {
                "name": "ipxe",
                "test": "substring(option[77].hex,0,4) == 'iPXE'",
                "boot-file-name": "http://{{ kea_warewulf_host }}:9873/ipxe/${mac:hexhyp}?assetkey=${asset}&uuid=${uuid}"
            }
        ],

        "hooks-libraries": [
            {
                "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
            },
            {
                "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_stat_cmds.so"
            }
        ],

        "subnet4": [
            {
                "id": 1,
                "subnet": "{{ kea_subnet }}",
                "pools": [ { "pool": "{{ kea_pool_start }} - {{ kea_pool_end }}" } ],
                "next-server": "{{ kea_warewulf_host }}",
                "boot-file-name": "{{ kea_boot_file }}",
                "option-data": [
                    {
                        "name": "routers",
                        "data": "{{ kea_gateway }}"
                    },
                    {
                        "name": "domain-name-servers",
                        "data": "{{ kea_dns }}"
                    }
                ],
                "reservations": [
    {% for node in groups.warewulf_nodes %}
                    {
                        "hw-address": "{{ hostvars[node].mac }}",
                        "ip-address": "{{ hostvars[node].ansible_host }}",
                        "hostname": "{{ node }}"
                    }{{ "," if not loop.last }}
    {% endfor %}
                ]
            }
        ],

        "loggers": [
        {
            "name": "kea-dhcp4",
            "output-options": [
                {
                    "output": "syslog"
                }
            ],
            "severity": "INFO"
        }
    ]
    }
}
